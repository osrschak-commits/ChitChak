# Copy to .env.production and set your domain before building the installer.
#
# These are baked into the build, so a build made with the wrong values will
# fail to connect no matter how the server is configured. Rebuild after
# changing them.

VITE_API_BASE=https://api.example.com

# The CSP allowlist. Both the API and the SFU appear here; the SFU is contacted
# directly by the WebRTC stack, so leaving it out breaks voice with a console
# error and no visible cause.
VITE_CONNECT_SRC=https://api.example.com wss://api.example.com https://sfu.example.com wss://sfu.example.com
VITE_IMG_SRC=https://api.example.com
