# Development: everything runs on this machine.
# Vite loads this automatically for `npm run dev`. No secrets belong here.

VITE_API_BASE=http://localhost:4000

# Hosts the renderer is allowed to reach, injected into the CSP in index.html.
VITE_CONNECT_SRC=http://localhost:4000 ws://localhost:4000 http://localhost:7880 ws://localhost:7880 wss://localhost:7880
VITE_IMG_SRC=http://localhost:4000
