# Caddy terminates TLS and routes the two public HTTP endpoints.
#
# Certificates are obtained and renewed automatically from Let's Encrypt, which
# is the whole reason for putting Caddy in front: passwords and access tokens
# cross these connections, and they should not do so in the clear.
#
# Media does NOT pass through here. WebRTC audio and video go straight to the
# SFU on 7881/tcp and 7882/udp - proxying them would add latency for no benefit
# and Caddy is not a media server.

{
	# Where Let's Encrypt sends expiry warnings.
	email {$ACME_EMAIL}
}

# The public site, and the web client it hosts at /app.
{$CHITCHAK_DOMAIN} {
	# Installers, served straight off the same directory the desktop app updates
	# from - one copy of each build, reachable under two names. handle_path
	# strips the prefix, so /download/ChitChak-Setup-1.0.0.exe is
	# /srv/updates/ChitChak-Setup-1.0.0.exe.
	#
	# `browse` gives /download/ a plain index. It is the fallback the download
	# page falls back to when it cannot read the manifests, and the honest
	# answer to "where are the older builds".
	handle_path /download/* {
		root * /srv/updates
		file_server browse
		header Cache-Control "public, max-age=300"
	}

	handle {
		reverse_proxy chitchak-site:80
	}

	header {
		X-Content-Type-Options nosniff
		# The site frames nothing and should be framed by nothing.
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format json
	}
}

# One canonical name. Without this, the web client at www would be a second
# origin - a second entry in the API's CORS allowlist, and a second, separate
# localStorage holding a second, separate login.
www.{$CHITCHAK_DOMAIN} {
	redir https://{$CHITCHAK_DOMAIN}{uri} permanent
}

# The API and the realtime gateway.
api.{$CHITCHAK_DOMAIN} {
	# Update artifacts, served as plain files rather than proxied to the API.
	# The desktop app checks latest.yml here on launch. Kept on this domain so
	# there is one certificate and one thing to keep running.
	handle /updates/* {
		root * /srv
		file_server
		header Cache-Control "public, max-age=60"
	}

	# Caddy upgrades WebSocket connections through reverse_proxy automatically,
	# so /gateway needs no special handling.
	handle {
		reverse_proxy chitchak-server:4000
	}

	header {
		# The API is only ever called by the desktop app, never embedded.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format json
	}
}

# SFU signalling. Media bypasses Caddy entirely; this is the WebSocket the
# client uses to negotiate, and it must be wss:// to match the API's https://.
sfu.{$CHITCHAK_DOMAIN} {
	reverse_proxy chitchak-livekit:7880

	log {
		output stdout
		format json
	}
}
