# Copy to .env.production ON THE SERVER and fill in. Never commit the real file.
#
# Generate each secret with:
#   openssl rand -base64 36
# or, if you only have Node:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"

# The domain you own. The stack serves it and two subdomains beneath it:
#   <domain>      - the website, and the web client at /app
#   www.<domain>  - redirects to <domain>
#   api.<domain>  - the API and realtime gateway
#   sfu.<domain>  - SFU signalling
# Point all four at this server's IP with A records before starting Caddy.
CHITCHAK_DOMAIN=example.com

# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# Database password. Only ever used inside the compose network.
POSTGRES_PASSWORD=

# Signs access tokens. Changing it logs everyone out, which is the emergency
# lever if you ever think it has leaked.
JWT_SECRET=

# Gate on registration. Strongly recommended once the server is on a public
# domain: without it, anyone who finds the address can create an account.
# Give this to your friends; they type it once when signing up.
# Leave empty to allow open registration.
SIGNUP_CODE=

# Before the doors open properly.
#
# "true" gives every new account the Founder badge, which cannot be bought and
# never comes out of a chest. Set it to "false" on launch day and no account
# made after that can ever have one - which is the whole point of the badge, so
# it is worth turning off on purpose rather than leaving on by accident.
#
# Accounts that predate this setting are credited by hand, once:
#   docker compose -f docker-compose.prod.yml run --rm \
#     migrate node apps/server/dist/db/award-founder.js --apply
PRE_LAUNCH=false

# Who may moderate the platform: read reports, suspend accounts, hand out
# black cards.
#
# Comma-separated user **ids**, not usernames. A username can be released and
# registered again by somebody else, and that would hand them the platform; an
# id belongs to one account for ever. Find yours after registering with:
#
#   docker exec chitchak-postgres psql -U chitchak -d chitchak -At \
#     -c "select id from users where username = 'yourname'"
#
# Read once at boot, so changing it needs a restart. Empty by default - a fresh
# deployment has no staff at all, which is right for a server somebody else is
# running. With nobody here, reports can be filed and never read.
PLATFORM_ADMINS=

# Outgoing mail. Optional, and only used for password resets today.
#
# Leave both blank and the server still starts and still accepts reset
# requests - it writes the link into its own log instead of emailing it, so a
# reset is something you do by hand rather than something nobody can do. Fill
# them in and people can reset their own passwords, which is the difference
# between a server for friends and a server for strangers.
#
# SMTP_URL is one connection string. Any provider works - Resend, Postmark,
# SES, Fastmail, your registrar's mailbox:
#   smtps://user:password@smtp.provider.com:465
# Percent-encode the password if it contains @ : / or #.
#
# MAIL_FROM must be an address the provider will let you send as, and its
# domain usually needs SPF and DKIM records or the mail lands in spam.
SMTP_URL=
MAIL_FROM=ChitChak <noreply@example.com>

# SFU credentials. The key may be anything memorable; the secret must be random
# and at least 32 characters. Anyone holding the secret can mint a token for any
# room, so treat it exactly like the JWT secret.
LIVEKIT_API_KEY=chitchak
LIVEKIT_API_SECRET=
