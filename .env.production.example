# Copy to .env.production ON THE SERVER and fill in. Never commit the real file.
#
# Generate each secret with:
#   openssl rand -base64 36
# or, if you only have Node:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"

# The domain you own. The stack uses two subdomains beneath it:
#   api.<domain>  - the API and realtime gateway
#   sfu.<domain>  - SFU signalling
# Point both at this server's IP with A records before starting Caddy.
CHITCHAK_DOMAIN=example.com

# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# Database password. Only ever used inside the compose network.
POSTGRES_PASSWORD=

# Signs access tokens. Changing it logs everyone out, which is the emergency
# lever if you ever think it has leaked.
JWT_SECRET=

# Gate on registration. Strongly recommended once the server is on a public
# domain: without it, anyone who finds the address can create an account.
# Give this to your friends; they type it once when signing up.
# Leave empty to allow open registration.
SIGNUP_CODE=

# SFU credentials. The key may be anything memorable; the secret must be random
# and at least 32 characters. Anyone holding the secret can mint a token for any
# room, so treat it exactly like the JWT secret.
LIVEKIT_API_KEY=chitchak
LIVEKIT_API_SECRET=
