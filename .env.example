# Copy to .env and adjust. The server reads this file on boot.

NODE_ENV=development
PORT=4000
# Where the desktop client reaches the API. Used for CORS.
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://chitchak:chitchak@localhost:5433/chitchak
REDIS_URL=redis://localhost:6380

# Signing key for access/refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# LiveKit SFU. LIVEKIT_URL is handed to clients; LIVEKIT_HOST is used by the
# server for the management API (they differ once you terminate TLS in front).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
