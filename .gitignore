node_modules/
dist/
dist-electron/
dist-web/
release/
*.tsbuildinfo

# Secrets. .env.example and .env.production.example are the templates; the real
# files never get committed.
.env
.env.local
.env.production

# Icons, generated during the packaging build - from the logo when there is
# one, and drawn by scripts/make-icon.mjs when there is not.
#
# The logo itself is the exception: it is a designed asset that exists nowhere
# else, so it is source and it is committed. Everything derived from it stays
# out, because it can be rebuilt and a binary in git cannot be diffed or merged.
apps/desktop/build/*
!apps/desktop/build/logo-source.png

# Published installers. On the server this is the directory Caddy serves at
# /updates and /download; locally it is whatever `npm run release` last built.
updates/

# Database dumps. Real accounts, real private conversations - this must never
# be committed, and it is on the server where an absent-minded `git add -A`
# would otherwise pick it up.
backups/

.DS_Store
Thumbs.db
