node_modules/
dist/
dist-electron/
dist-web/
release/
*.tsbuildinfo

# Secrets. .env.example and .env.production.example are the templates; the real
# files never get committed.
.env
.env.local
.env.production

# Generated by scripts/make-icon.mjs during the packaging build.
apps/desktop/build/

# Published installers. On the server this is the directory Caddy serves at
# /updates and /download; locally it is whatever `npm run release` last built.
updates/

# Database dumps. Real accounts, real private conversations - this must never
# be committed, and it is on the server where an absent-minded `git add -A`
# would otherwise pick it up.
backups/

.DS_Store
Thumbs.db
